# Copy to .env.local (git-ignored). PUBLIC values only: everything prefixed
# VITE_ is embedded in the browser bundle. Never put a service-role key or an
# LLM API key here.

# Supabase project → Settings → API (Project URL and the public "anon" key)
VITE_SUPABASE_URL=https://hbcyqmupfaeiledpzmop.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhiY3lxbXVwZmFlaWxlZHB6bW9wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA2OTcwODcsImV4cCI6MjEwNjI3MzA4N30.YTLO4XUnoIUl_bJFZ0ONFwYcZHnbmmNzmFaoxN3BwZ8

# Client-side upload limit in decimal MB. The Free deployment caps this at
# 50 MB (50,000,000 bytes), even if a larger value is configured.
VITE_MAX_UPLOAD_MB=50

# Local FastAPI prototype (developer tool; see server/README section in README.md)
VITE_CV_BACKEND_URL=http://localhost:8000

# Dev tools are on in `npm run dev` and off by default in production builds.
# Only set these for a dedicated testing build that should expose them.
# VITE_ENABLE_DESIGN_PREVIEW=true
# VITE_ENABLE_LOCAL_PROTOTYPE=true
# VITE_ENABLE_DEV_MODE=true
# Guest entry signs in as a Supabase anonymous user (no mock data). Needs
# "Allow anonymous sign-ins" in the project, which also lets guests upload.
# VITE_ENABLE_GUEST_MODE=true
# Public sample site without an always-on analysis worker. Disables new video uploads.
# VITE_TRIAL_NO_WORKER=true
