        "arc_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image-space rise of the ball path above its chord / chord length. Not ball height.",
          "title": "Arc Ratio"
