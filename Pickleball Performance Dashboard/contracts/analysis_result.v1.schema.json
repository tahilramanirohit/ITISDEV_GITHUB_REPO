          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "const": "whole_clip",
          "default": "whole_clip",
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositioningValue"
