        },
        "rallies": {
          "items": {
            "$ref": "#/$defs/RallySummary"
          },
          "title": "Rallies",
          "type": "array"
        },
        "complete_count": {
          "title": "Complete Count",
          "type": "integer"
        },
        "truncated_count": {
          "title": "Truncated Count",
