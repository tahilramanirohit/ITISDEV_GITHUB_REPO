{
  "$defs": {
    "BallSnapshot": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "bbox": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "time_seconds",
        "bbox",
        "confidence"
      ],
      "title": "BallSnapshot",
      "type": "object"
    },
    "BounceCandidate": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "ball_px": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Ball Px",
          "type": "array"
        },
        "court_xy_m": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Xy M"
        }
      },
      "required": [
        "time_seconds",
        "ball_px"
      ],
      "title": "BounceCandidate",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "manual_landmarks",
            "auto_model_landmarks"
          ],
          "title": "Method",
          "type": "string"
        },
        "court_model": {
          "title": "Court Model",
          "type": "string"
        },
        "landmarks_used": {
          "items": {
            "type": "string"
          },
          "title": "Landmarks Used",
          "type": "array"
        },
        "reprojection_rmse_px": {
          "title": "Reprojection Rmse Px",
          "type": "number"
        },
        "reprojection_rmse_m": {
          "title": "Reprojection Rmse M",
          "type": "number"
        },
        "quality": {
          "enum": [
            "good",
            "poor"
          ],
          "title": "Quality",
          "type": "string"
        }
      },
      "required": [
        "method",
        "court_model",
        "landmarks_used",
        "reprojection_rmse_px",
        "reprojection_rmse_m",
        "quality"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "CourtHeatmapMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "insufficient_data",
            "not_computed",
            "experimental"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "synthetic_only",
            "evaluated_on_real_footage"
          ],
          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "const": "whole_clip",
          "default": "whole_clip",
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeatmapValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "CourtHeatmapMetric",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "analyzed_start_s": {
          "title": "Analyzed Start S",
          "type": "number"
        },
        "analyzed_end_s": {
          "title": "Analyzed End S",
          "type": "number"
        },
        "analyzed_duration_s": {
          "title": "Analyzed Duration S",
          "type": "number"
        },
        "frames_decoded": {
          "title": "Frames Decoded",
          "type": "integer"
        },
        "frames_analyzed": {
          "title": "Frames Analyzed",
          "type": "integer"
        },
        "sample_stride": {
          "description": "Every Nth decoded frame was analyzed.",
          "title": "Sample Stride",
          "type": "integer"
        },
        "decode_failures": {
          "title": "Decode Failures",
          "type": "integer"
        },
        "stopped_early_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when analysis stopped before the end of the video (e.g. max_seconds).",
          "title": "Stopped Early Reason"
        },
        "fraction_of_video_analyzed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction Of Video Analyzed"
        },
        "frames_with_detections": {
          "title": "Frames With Detections",
          "type": "integer"
        },
        "frames_with_ball_detections": {
          "default": 0,
          "title": "Frames With Ball Detections",
          "type": "integer"
        }
      },
      "required": [
        "analyzed_start_s",
        "analyzed_end_s",
        "analyzed_duration_s",
        "frames_decoded",
        "frames_analyzed",
        "sample_stride",
        "decode_failures",
        "frames_with_detections"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DetectorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "confidence_is_model_score": {
          "description": "True only when per-detection confidence comes from a model. Motion-based detection has no confidence and reports null.",
          "title": "Confidence Is Model Score",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "confidence_is_model_score"
      ],
      "title": "DetectorInfo",
      "type": "object"
    },
    "HeatmapValue": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "const": "seconds",
          "default": "seconds",
          "title": "Units",
          "type": "string"
        },
        "coordinate_system": {
          "title": "Coordinate System",
          "type": "string"
        },
        "cell_size_m": {
          "title": "Cell Size M",
          "type": "number"
        },
        "x_edges_m": {
          "items": {
            "type": "number"
          },
          "title": "X Edges M",
          "type": "array"
        },
        "y_edges_m": {
          "items": {
            "type": "number"
          },
          "title": "Y Edges M",
          "type": "array"
        },
        "dwell_seconds": {
          "description": "rows follow y (near\u2192far), columns follow x (left\u2192right)",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Dwell Seconds",
          "type": "array"
        },
        "tracked_time_s": {
          "title": "Tracked Time S",
          "type": "number"
        },
        "outside_mapped_area_s": {
          "title": "Outside Mapped Area S",
          "type": "number"
        }
      },
      "required": [
        "coordinate_system",
        "cell_size_m",
        "x_edges_m",
        "y_edges_m",
        "dwell_seconds",
        "tracked_time_s",
        "outside_mapped_area_s"
      ],
      "title": "HeatmapValue",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "court_heatmap": {
          "$ref": "#/$defs/CourtHeatmapMetric"
        },
        "zone_occupancy": {
          "$ref": "#/$defs/ZoneOccupancyMetric"
        },
        "positioning": {
          "$ref": "#/$defs/PositioningMetric"
        },
        "rally_segmentation": {
          "$ref": "#/$defs/RallyMetric"
        },
        "shot_classification": {
          "$ref": "#/$defs/ShotMetric"
        }
      },
      "required": [
        "court_heatmap",
        "zone_occupancy",
        "rally_segmentation",
        "shot_classification"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "PlayerBox": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "bbox": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "PlayerBox",
      "type": "object"
    },
    "PlayerSelectionSummary": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "track_id",
            "court_half"
          ],
          "title": "Method",
          "type": "string"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "court_half": {
          "anyOf": [
            {
              "enum": [
                "near",
                "far"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Half"
        },
        "tracked_time_s": {
          "title": "Tracked Time S",
          "type": "number"
        },
        "tracked_fraction": {
          "description": "tracked_time_s / coverage.analyzed_duration_s",
          "title": "Tracked Fraction",
          "type": "number"
        },
        "ambiguous_frames": {
          "default": 0,
          "description": "Frames excluded because the selection matched >1 detection.",
          "title": "Ambiguous Frames",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "tracked_time_s",
        "tracked_fraction"
      ],
      "title": "PlayerSelectionSummary",
      "type": "object"
    },
    "PositionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerBox"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "time_seconds",
        "players"
      ],
      "title": "PositionSnapshot",
      "type": "object"
    },
    "PositioningMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
