    "ShotContact": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "rally_index": {
          "title": "Rally Index",
          "type": "integer"
        },
        "shot_class": {
          "enum": [
            "serve",
            "return",
            "overhead",
            "volley",
            "dink",
            "drive",
            "lob",
            "unclassified"
          ],
          "title": "Shot Class",
          "type": "string"
        },
        "evidence": {
          "description": "Rule evidence, not an accuracy probability.",
