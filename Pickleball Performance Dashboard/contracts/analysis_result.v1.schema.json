          "type": "boolean"
        },
        "speed_player_heights_per_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image speed after contact divided by the hitter's box height. A proxy, not km/h.",
          "title": "Speed Player Heights Per S"
