              "$ref": "#/$defs/DetectorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/SourceInfo"
        }
      },
      "required": [
        "pipeline_version",
        "generated_at",
        "detector",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
