{
  "$defs": {
    "BallSnapshot": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "bbox": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "time_seconds",
        "bbox",
        "confidence"
      ],
      "title": "BallSnapshot",
      "type": "object"
    },
    "BounceEvent": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "court_m": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court M"
        },
        "in_court": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Court"
        }
      },
      "required": [
        "time_seconds"
      ],
      "title": "BounceEvent",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "manual_landmarks",
            "auto_model_landmarks"
          ],
          "title": "Method",
          "type": "string"
        },
        "court_model": {
          "title": "Court Model",
          "type": "string"
        },
        "landmarks_used": {
          "items": {
            "type": "string"
          },
          "title": "Landmarks Used",
          "type": "array"
        },
        "reprojection_rmse_px": {
          "title": "Reprojection Rmse Px",
          "type": "number"
        },
        "reprojection_rmse_m": {
          "title": "Reprojection Rmse M",
          "type": "number"
        },
        "quality": {
          "enum": [
            "good",
            "poor"
          ],
          "title": "Quality",
          "type": "string"
        }
      },
      "required": [
        "method",
        "court_model",
        "landmarks_used",
        "reprojection_rmse_px",
        "reprojection_rmse_m",
        "quality"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "CourtHeatmapMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "insufficient_data",
            "not_computed",
            "experimental"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "synthetic_only",
            "evaluated_on_real_footage"
          ],
          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "default": "whole_clip",
          "enum": [
            "whole_clip",
            "selected_view"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeatmapValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "CourtHeatmapMetric",
      "type": "object"
    },
    "CourtLinesSnapshot": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "lines": {
          "description": "Court lines as [x1, y1, x2, y2] image pixels, valid until the next snapshot; empty when the court was not mapped from this time on.",
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "time_seconds",
        "lines"
      ],
      "title": "CourtLinesSnapshot",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "analyzed_start_s": {
          "title": "Analyzed Start S",
          "type": "number"
        },
        "analyzed_end_s": {
          "title": "Analyzed End S",
          "type": "number"
        },
        "analyzed_duration_s": {
          "title": "Analyzed Duration S",
          "type": "number"
        },
        "frames_decoded": {
          "title": "Frames Decoded",
          "type": "integer"
        },
        "frames_analyzed": {
          "title": "Frames Analyzed",
          "type": "integer"
        },
        "sample_stride": {
          "description": "Every Nth decoded frame was analyzed.",
          "title": "Sample Stride",
          "type": "integer"
        },
        "decode_failures": {
          "title": "Decode Failures",
          "type": "integer"
        },
        "stopped_early_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when analysis stopped before the end of the video (e.g. max_seconds).",
          "title": "Stopped Early Reason"
        },
        "fraction_of_video_analyzed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction Of Video Analyzed"
        },
        "frames_with_detections": {
          "title": "Frames With Detections",
          "type": "integer"
        },
        "frames_with_ball_detections": {
          "default": 0,
          "title": "Frames With Ball Detections",
          "type": "integer"
        },
        "selected_view_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration of the selected camera view when a cut was detected; null for a continuous video.",
          "title": "Selected View Duration S"
        }
      },
      "required": [
        "analyzed_start_s",
        "analyzed_end_s",
        "analyzed_duration_s",
        "frames_decoded",
        "frames_analyzed",
        "sample_stride",
        "decode_failures",
        "frames_with_detections"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DetectorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "confidence_is_model_score": {
          "description": "True only when per-detection confidence comes from a model. Motion-based detection has no confidence and reports null.",
          "title": "Confidence Is Model Score",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "confidence_is_model_score"
      ],
      "title": "DetectorInfo",
      "type": "object"
    },
    "HeatmapValue": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "const": "seconds",
          "default": "seconds",
          "title": "Units",
          "type": "string"
        },
        "coordinate_system": {
          "title": "Coordinate System",
          "type": "string"
        },
        "cell_size_m": {
          "title": "Cell Size M",
          "type": "number"
        },
        "x_edges_m": {
          "items": {
            "type": "number"
          },
          "title": "X Edges M",
          "type": "array"
        },
        "y_edges_m": {
          "items": {
            "type": "number"
          },
          "title": "Y Edges M",
          "type": "array"
        },
        "dwell_seconds": {
          "description": "rows follow y (near\u2192far), columns follow x (left\u2192right)",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Dwell Seconds",
          "type": "array"
        },
        "tracked_time_s": {
          "title": "Tracked Time S",
          "type": "number"
        },
        "outside_mapped_area_s": {
          "title": "Outside Mapped Area S",
          "type": "number"
        }
      },
      "required": [
        "coordinate_system",
        "cell_size_m",
        "x_edges_m",
        "y_edges_m",
        "dwell_seconds",
        "tracked_time_s",
        "outside_mapped_area_s"
      ],
      "title": "HeatmapValue",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "court_heatmap": {
          "$ref": "#/$defs/CourtHeatmapMetric"
        },
        "zone_occupancy": {
          "$ref": "#/$defs/ZoneOccupancyMetric"
        },
        "positioning": {
          "$ref": "#/$defs/PositioningMetric"
        },
        "rally_segmentation": {
          "$ref": "#/$defs/RallySegmentationMetric"
        },
        "shot_classification": {
          "$ref": "#/$defs/ShotClassificationMetric"
        }
      },
      "required": [
        "court_heatmap",
        "zone_occupancy",
        "rally_segmentation",
        "shot_classification"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "PlayerBox": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "bbox": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "selected": {
          "default": false,
          "description": "True when this box is the player chosen for court feedback in this frame.",
          "title": "Selected",
          "type": "boolean"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "PlayerBox",
      "type": "object"
    },
    "PlayerSelectionSummary": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "track_id",
            "court_half"
          ],
          "title": "Method",
          "type": "string"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "court_half": {
          "anyOf": [
            {
              "enum": [
                "near",
                "far"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Half"
        },
        "tracked_time_s": {
          "title": "Tracked Time S",
          "type": "number"
        },
        "tracked_fraction": {
          "description": "tracked_time_s / selected view duration, or whole analyzed duration for a continuous video",
          "title": "Tracked Fraction",
          "type": "number"
        },
        "ambiguous_frames": {
          "default": 0,
          "description": "Frames excluded because the selection matched >1 detection.",
          "title": "Ambiguous Frames",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "tracked_time_s",
        "tracked_fraction"
      ],
      "title": "PlayerSelectionSummary",
      "type": "object"
    },
    "PositionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerBox"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "time_seconds",
        "players"
      ],
      "title": "PositionSnapshot",
      "type": "object"
    },
    "PositioningMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "insufficient_data",
            "not_computed",
            "experimental"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "synthetic_only",
            "evaluated_on_real_footage"
          ],
          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "default": "whole_clip",
          "enum": [
            "whole_clip",
            "selected_view"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositioningValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "PositioningMetric",
      "type": "object"
    },
    "PositioningValue": {
      "additionalProperties": false,
      "properties": {
        "court_half": {
          "description": "The selected player's side; depths are from this baseline.",
          "enum": [
            "near",
            "far"
          ],
          "title": "Court Half",
          "type": "string"
        },
        "band_definitions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Band Definitions",
          "type": "object"
        },
        "seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Seconds",
          "type": "object"
        },
        "fraction_of_mapped_time": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Fraction Of Mapped Time",
          "type": "object"
        },
        "mapped_time_s": {
          "title": "Mapped Time S",
          "type": "number"
        },
        "left_side_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of in-court time on the player's own left half, facing the net.",
          "title": "Left Side Fraction"
        },
        "transition_lingers": {
          "description": "Continuous stays of at least 2 s in the transition band.",
          "title": "Transition Lingers",
          "type": "integer"
        },
        "longest_transition_linger_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longest Transition Linger S"
        },
        "approaches_to_kitchen_line": {
          "description": "Moves from the baseline bands to the kitchen-line bands.",
          "title": "Approaches To Kitchen Line",
          "type": "integer"
        },
        "median_approach_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median time from last baseline-area sample to first kitchen-line sample.",
          "title": "Median Approach S"
        },
        "retreats_to_baseline": {
          "title": "Retreats To Baseline",
          "type": "integer"
        },
        "distance_covered_m": {
          "description": "Path length of the smoothed foot position; includes walking between points.",
          "title": "Distance Covered M",
          "type": "number"
        }
      },
      "required": [
        "court_half",
        "band_definitions",
        "seconds",
        "fraction_of_mapped_time",
        "mapped_time_s",
        "transition_lingers",
        "approaches_to_kitchen_line",
        "retreats_to_baseline",
        "distance_covered_m"
      ],
      "title": "PositioningValue",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "detector": {
          "$ref": "#/$defs/DetectorInfo"
        },
        "ball_detector": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/SourceInfo"
        }
      },
      "required": [
        "pipeline_version",
        "generated_at",
        "detector",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RallySegmentationMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "insufficient_data",
            "not_computed",
            "experimental"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "synthetic_only",
            "evaluated_on_real_footage"
          ],
          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "default": "whole_clip",
          "enum": [
            "whole_clip",
            "selected_view"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/RallyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "RallySegmentationMetric",
      "type": "object"
    },
    "RallySummary": {
      "additionalProperties": false,
      "properties": {
        "rally_index": {
          "title": "Rally Index",
          "type": "integer"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "shots": {
          "title": "Shots",
          "type": "integer"
        }
      },
      "required": [
        "rally_index",
        "start_s",
        "end_s",
        "shots"
      ],
      "title": "RallySummary",
      "type": "object"
    },
    "RallyValue": {
      "additionalProperties": false,
      "properties": {
        "rallies": {
          "items": {
            "$ref": "#/$defs/RallySummary"
          },
          "title": "Rallies",
          "type": "array"
        },
        "rally_time_s": {
          "title": "Rally Time S",
          "type": "number"
        }
      },
      "required": [
        "rallies",
        "rally_time_s"
      ],
      "title": "RallyValue",
      "type": "object"
    },
    "ShotClassificationMetric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "measured",
            "insufficient_data",
            "not_computed",
            "experimental"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "synthetic_only",
            "evaluated_on_real_footage"
          ],
          "title": "Validation",
          "type": "string"
        },
        "scope": {
          "default": "whole_clip",
          "enum": [
            "whole_clip",
            "selected_view"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the metric is missing, partial, or experimental.",
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotsValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "ShotClassificationMetric",
      "type": "object"
    },
    "ShotEvent": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "rally_index": {
          "title": "Rally Index",
          "type": "integer"
        },
        "shot_number": {
          "description": "1-based position of the shot within its rally.",
          "title": "Shot Number",
          "type": "integer"
        },
        "hitter_track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hitter Track Id"
        },
        "hitter_side": {
          "anyOf": [
            {
              "enum": [
                "near",
                "far"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hitter Side"
        },
        "by_selected_player": {
          "default": false,
          "title": "By Selected Player",
          "type": "boolean"
        },
        "hitter_court_m": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hitter Court M"
        },
        "shot_type": {
          "enum": [
            "serve",
            "return",
            "drive",
            "drop",
            "dink",
            "volley",
            "lob",
            "overhead",
            "unclassified"
          ],
          "title": "Shot Type",
          "type": "string"
        },
        "contact": {
          "default": "unknown",
          "enum": [
            "volley",
            "after_bounce",
            "unknown"
          ],
          "title": "Contact",
          "type": "string"
        },
        "ground_speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Horizontal ground distance to the next bounce or hitter divided by the time taken.",
          "title": "Ground Speed Mps"
        },
        "landing_court_m": {
          "anyOf": [
