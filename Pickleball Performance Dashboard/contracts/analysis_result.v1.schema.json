          "type": "boolean"
        },
        "contact_count": {
          "title": "Contact Count",
          "type": "integer"
        },
        "ball_observed_fraction": {
          "description": "Share of the rally's duration with an observed ball.",
          "title": "Ball Observed Fraction",
          "type": "number"
        }
      },
      "required": [
        "index",
        "start_s",
        "end_s",
        "complete",
        "contact_count",
        "ball_observed_fraction"
      ],
      "title": "RallySummary",
      "type": "object"
    },
    "RallyValue": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "title": "Definition",
