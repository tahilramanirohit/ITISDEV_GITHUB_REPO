# Copy to server/.env (git-ignored). SERVER-SIDE ONLY — never ship to the browser.

# ── Job worker (python -m picklepro.worker) ─────────────────────────────────
SUPABASE_URL=
# Bypasses row-level security. Keep it on the machine that runs the worker.
SUPABASE_SERVICE_ROLE_KEY=
# measured     = run the CV pipeline on the uploaded video
# test_fixture = store a clearly labelled canned result (for testing the app flow)
WORKER_RESULT_MODE=measured
WORKER_POLL_INTERVAL_S=5
WORKER_LEASE_SECONDS=300
PICKLEPRO_DETECTOR=motion
# PICKLEPRO_YOLO_WEIGHTS=/absolute/path/to/weights.pt   # only with requirements-yolo.txt
# PICKLEPRO_COURT_WEIGHTS=/absolute/path/to/court_pose.pt # optional 14-keypoint court model; same optional requirements
# PICKLEPRO_BALL_WEIGHTS=/absolute/path/to/ball_model.pt  # optional model with a pickleball/ball class

# ── Local FastAPI prototype (python main.py) ────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_API_MAX_FILE_SIZE_MB=150
LOCAL_API_MAX_SECONDS=600

# ── Experimental, outside increments 1–2 ────────────────────────────────────
# PICKLEPRO_ENABLE_EXPERIMENTAL_RAG=1
# ANTHROPIC_API_KEY=
